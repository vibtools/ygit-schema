---
import { Github, X } from '@lucide/astro';
import { GITHUB_URL } from '@/constants/config';
import { ROUTES } from '@/constants/routes';

const items = [
  ['Schemas', ROUTES.schemas],
  ['Documentation', ROUTES.documentation],
  ['Examples', ROUTES.examples],
  ['Versions', ROUTES.versions],
  ['Changelog', ROUTES.changelog],
  ['Search', ROUTES.search],
] as const;
---
<div id="mobile-drawer-root" class="pointer-events-none fixed inset-0 z-[70] hidden lg:hidden" aria-hidden="true">
  <button id="mobile-drawer-backdrop" class="absolute inset-0 cursor-default bg-black/70 opacity-0 transition-opacity duration-150" type="button" aria-label="Close navigation"></button>
  <aside id="mobile-drawer" class="absolute inset-y-0 left-0 flex w-[min(86vw,320px)] -translate-x-full flex-col border-r border-border bg-background shadow-2xl transition-transform duration-200" role="dialog" aria-modal="true" aria-labelledby="mobile-drawer-title" tabindex="-1">
    <div class="flex min-h-[var(--header-mobile-height)] items-center justify-between border-b border-border px-4">
      <h2 id="mobile-drawer-title" class="text-h3 font-semibold text-text">Navigation</h2>
      <button id="mobile-drawer-close" class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-button border border-border text-content hover:bg-surface-hover" type="button" aria-label="Close navigation"><X size={19} aria-hidden="true" /></button>
    </div>
    <nav class="flex flex-1 flex-col gap-1 overflow-y-auto p-4" aria-label="Mobile navigation">
      {items.map(([label, href]) => <a class="flex min-h-11 items-center rounded-button px-3 text-base font-medium text-content no-underline hover:bg-surface-hover hover:text-text" href={href}>{label}</a>)}
      <a class="mt-3 flex min-h-11 items-center gap-2 rounded-button border border-border px-3 text-base font-medium text-content no-underline hover:bg-surface-hover hover:text-text" href={GITHUB_URL} rel="noreferrer"><Github size={18} aria-hidden="true" />GitHub</a>
    </nav>
  </aside>
</div>
<script>
  const root = document.querySelector<HTMLElement>('#mobile-drawer-root');
  const drawer = document.querySelector<HTMLElement>('#mobile-drawer');
  const trigger = document.querySelector<HTMLButtonElement>('#mobile-menu-button');
  const closeButton = document.querySelector<HTMLButtonElement>('#mobile-drawer-close');
  const backdrop = document.querySelector<HTMLButtonElement>('#mobile-drawer-backdrop');
  let previousFocus: HTMLElement | null = null;

  const focusableSelector = 'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';

  function openDrawer(): void {
    if (!root || !drawer || !trigger) return;
    previousFocus = document.activeElement instanceof HTMLElement ? document.activeElement : trigger;
    root.classList.remove('hidden');
    root.classList.remove('pointer-events-none');
    root.setAttribute('aria-hidden', 'false');
    trigger.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    requestAnimationFrame(() => {
      drawer.classList.remove('-translate-x-full');
      backdrop?.classList.remove('opacity-0');
      closeButton?.focus();
    });
  }

  function closeDrawer(): void {
    if (!root || !drawer || !trigger) return;
    drawer.classList.add('-translate-x-full');
    backdrop?.classList.add('opacity-0');
    trigger.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    window.setTimeout(() => {
      root.classList.add('hidden', 'pointer-events-none');
      root.setAttribute('aria-hidden', 'true');
      previousFocus?.focus();
    }, 200);
  }

  trigger?.addEventListener('click', openDrawer);
  closeButton?.addEventListener('click', closeDrawer);
  backdrop?.addEventListener('click', closeDrawer);
  root?.querySelectorAll('a[href]').forEach((link) => link.addEventListener('click', closeDrawer));
  window.addEventListener('resize', () => {
    if (window.matchMedia('(min-width: 1024px)').matches && root?.getAttribute('aria-hidden') === 'false') {
      closeDrawer();
    }
  });
  document.addEventListener('keydown', (event) => {
    if (root?.getAttribute('aria-hidden') !== 'false') return;
    if (event.key === 'Escape') {
      event.preventDefault();
      closeDrawer();
      return;
    }
    if (event.key !== 'Tab' || !drawer) return;
    const focusable = Array.from(drawer.querySelectorAll<HTMLElement>(focusableSelector));
    const first = focusable.at(0);
    const last = focusable.at(-1);
    if (!first || !last) return;
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });
</script>
