---
import navigation from '@/data/navigation.json';
import { getActivePath } from '@/utils/getActivePath';
const currentPath = Astro.url.pathname;
---
<aside class="hidden w-[var(--sidebar-width)] shrink-0 lg:block"><nav aria-label="Documentation navigation" class="sticky top-[calc(var(--header-height)+var(--space-5))] max-h-[calc(100vh-var(--header-height)-40px)] overflow-y-auto rounded-card border border-border bg-surface p-3">{navigation.map((group) => <section><h2 class="mb-2 mt-4 first:mt-1 text-xs font-semibold uppercase tracking-wider text-muted">{group.title}</h2><ul class="grid gap-1">{group.items.map((item) => <li><a class:list={['block rounded-button px-3 py-2 text-base no-underline transition-colors duration-150', getActivePath(currentPath, item.href) ? 'bg-surface-hover text-accent' : 'text-content hover:bg-surface-hover hover:text-text']} href={item.href}>{item.label}</a></li>)}</ul></section>)}</nav></aside>
