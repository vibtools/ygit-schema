---
type Variant = 'stable' | 'beta' | 'deprecated' | 'draft' | 'neutral';
type Props = Readonly<{ variant?: Variant; class?: string }>;
const { variant = 'neutral', class: className = '' } = Astro.props;
const variants: Record<Variant, string> = {
  stable: 'border-success/40 bg-success/10 text-success',
  beta: 'border-warning/40 bg-warning/10 text-warning',
  deprecated: 'border-danger/40 bg-danger/10 text-danger',
  draft: 'border-accent/40 bg-accent/10 text-accent',
  neutral: 'border-border bg-background text-muted',
};
---
<span class:list={['inline-flex min-h-5 items-center rounded-full border px-2 py-0.5 text-xs font-semibold', variants[variant], className]}><slot /></span>
