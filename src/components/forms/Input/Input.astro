---
type Props = Readonly<{ id: string; label: string; name?: string; type?: string; placeholder?: string; value?: string; required?: boolean; error?: string }>;
const { id, label, name = id, type = 'text', placeholder, value, required = false, error } = Astro.props;
---
<div>
  <label class="mb-2 block text-md font-medium text-text" for={id}>{label}{required && <span aria-hidden="true"> *</span>}</label>
  <input class:list={['min-h-10 w-full rounded-button border bg-background px-3 text-base text-text placeholder:text-muted', error ? 'border-danger' : 'border-border focus:border-accent']} id={id} name={name} type={type} placeholder={placeholder} value={value} required={required} aria-invalid={error ? 'true' : undefined} aria-describedby={error ? `${id}-error` : undefined} />
  {error && <p id={`${id}-error`} class="mt-1 text-sm text-danger">{error}</p>}
</div>
