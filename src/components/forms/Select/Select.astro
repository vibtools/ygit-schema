---
type Option = Readonly<{ value: string; label: string }>;
type Props = Readonly<{ id: string; label: string; name?: string; options: readonly Option[]; value?: string }>;
const { id, label, name = id, options, value } = Astro.props;
---
<div><label class="mb-2 block text-md font-medium text-text" for={id}>{label}</label><select class="min-h-10 w-full rounded-button border border-border bg-background px-3 text-base text-text focus:border-accent" id={id} name={name}>{options.map((option) => <option value={option.value} selected={option.value === value}>{option.label}</option>)}</select></div>
