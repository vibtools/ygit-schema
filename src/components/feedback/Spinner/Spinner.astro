---
type Props = Readonly<{ label?: string }>;
const { label = 'Loading' } = Astro.props;
---
<div class="inline-flex items-center gap-2 text-base text-muted" role="status"><span class="h-4 w-4 animate-spin rounded-full border-2 border-border border-t-accent" aria-hidden="true"></span><span>{label}</span></div>
