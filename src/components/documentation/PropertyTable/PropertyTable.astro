---
import type { SchemaProperty } from '@/types/schema';
type Props = Readonly<{ properties: readonly SchemaProperty[] }>;
const { properties } = Astro.props;
---
<div class="overflow-x-auto rounded-card border border-border">
  <table class="w-full min-w-[720px] border-collapse text-left">
    <thead><tr class="border-b border-border"><th class="p-3 text-sm font-semibold text-text">Name</th><th class="p-3 text-sm font-semibold text-text">Type</th><th class="p-3 text-sm font-semibold text-text">Required</th><th class="p-3 text-sm font-semibold text-text">Description</th></tr></thead>
    <tbody>{properties.map((property) => (
      <tr class="min-h-11 border-b border-border last:border-0 hover:bg-surface-hover">
        <td class="p-3 font-mono text-md text-accent">{property.name}</td>
        <td class="p-3 font-mono text-md text-content">{property.type}</td>
        <td class="p-3 text-base text-content">{property.required ? 'Yes' : 'No'}</td>
        <td class="p-3 text-base text-content">{property.description}</td>
      </tr>
    ))}</tbody>
  </table>
</div>
