---
import BottomNavigation from '@/components/layout/BottomNavigation';
import Footer from '@/components/layout/Footer';
import Header from '@/components/layout/Header';
import MobileDrawer from '@/components/layout/MobileDrawer';
import { SITE_DESCRIPTION, SITE_NAME, SITE_URL } from '@/constants/config';
import '@/styles/global.css';
type SearchCategory = 'schema' | 'documentation' | 'example';
type Props = Readonly<{
  title?: string | undefined;
  description?: string | undefined;
  image?: string | undefined;
  noindex?: boolean | undefined;
  indexable?: boolean | undefined;
  category?: SearchCategory | undefined;
  markdownHref?: string | undefined;
  structuredDataOverride?: Record<string, unknown> | readonly Record<string, unknown>[] | undefined;
}>;
const {
  title,
  description = SITE_DESCRIPTION,
  image = '/social-card.svg',
  noindex = false,
  indexable = true,
  category = 'documentation',
  markdownHref,
  structuredDataOverride,
} = Astro.props;
const pageTitle = title ? `${title} | ${SITE_NAME}` : `YGit Schema Registry | ${SITE_NAME}`;
const canonical = new URL(Astro.url.pathname, SITE_URL);

const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
const isFaq = Astro.url.pathname.includes('/faq');
const isDocOrSchema = Astro.url.pathname.startsWith('/docs/') || Astro.url.pathname.startsWith('/schemas/');

let schemaGraph: Record<string, unknown> | Record<string, unknown>[];

if (structuredDataOverride) {
  schemaGraph = structuredDataOverride as Record<string, unknown>;
} else if (isHome) {
  schemaGraph = [
    {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'YGit Schema Registry',
      url: SITE_URL,
      description,
      publisher: {
        '@type': 'Organization',
        name: 'Vib Tools',
        url: SITE_URL,
        logo: `${SITE_URL}/favicon.svg`,
      },
      potentialAction: {
        '@type': 'SearchAction',
        target: `${SITE_URL}/search/?q={search_term_string}`,
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'Vib Tools',
      url: SITE_URL,
      logo: `${SITE_URL}/favicon.svg`,
      sameAs: [
        'https://github.com/vibtools',
        'https://github.com/vibtools/ygit-schema',
      ],
    },
  ];
} else if (isFaq) {
  schemaGraph = {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'Is a .ygit file JSON?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes. VPMS files use JSON syntax with the .ygit extension.',
        },
      },
      {
        '@type': 'Question',
        name: 'Which fields are required?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'At the root: $schema, schemaVersion, manifestVersion, and project. Inside project: id, name, description, and version.',
        },
      },
      {
        '@type': 'Question',
        name: 'Are unknown properties allowed?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'No. VPMS Version 1 rejects unknown properties at every defined object level.',
        },
      },
      {
        '@type': 'Question',
        name: 'Can the manifest contain secrets?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'No. Store secrets in environment variables or a dedicated secret manager.',
        },
      },
      {
        '@type': 'Question',
        name: 'How do I validate all repository fixtures?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Run python scripts/validate.py --all after installing requirements.txt.',
        },
      },
      {
        '@type': 'Question',
        name: 'How is the website deployed?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Cloudflare Pages uses Git integration with the main branch. GitHub Actions performs validation and build checks but does not perform production deployment.',
        },
      },
    ],
  };
} else if (isDocOrSchema) {
  schemaGraph = {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: pageTitle,
    description,
    url: canonical.toString(),
    inLanguage: 'en',
    datePublished: '2026-07-28',
    dateModified: '2026-09-09',
    publisher: {
      '@type': 'Organization',
      name: 'Vib Tools',
      url: SITE_URL,
      logo: `${SITE_URL}/favicon.svg`,
    },
    author: {
      '@type': 'Organization',
      name: 'Vib Tools',
      url: SITE_URL,
    },
  };
} else {
  schemaGraph = {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: pageTitle,
    description,
    url: canonical.toString(),
    publisher: {
      '@type': 'Organization',
      name: 'Vib Tools',
      url: SITE_URL,
    },
  };
}

const structuredData = JSON.stringify(schemaGraph).replaceAll('<', '\\u003c');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM context summary" />
    <link rel="alternate" type="text/plain" href="/llms-full.txt" title="Full LLM context" />
    {markdownHref && <link rel="alternate" type="text/markdown" href={markdownHref} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, SITE_URL)} />
    <meta name="twitter:card" content="summary_large_image" />
    {indexable && <meta data-pagefind-meta="category[content]" data-pagefind-filter="category[content]" content={category} />}
    <title>{pageTitle}</title>
    <script is:inline type="application/ld+json" set:html={structuredData}></script>
  </head>
  <body>
    <a class="sr-only z-[100] bg-primary p-3 text-white focus:not-sr-only focus:fixed focus:left-3 focus:top-3" href="#main-content">Skip to content</a>
    <Header />
    <MobileDrawer />
    <main id="main-content" data-pagefind-body={indexable ? true : undefined}><slot /></main>
    <Footer />
    <BottomNavigation />
    <script>
      document.addEventListener('keydown', (event) => {
        const target = event.target as HTMLElement | null;
        const isTyping = target?.matches('input, textarea, select, [contenteditable="true"]');
        if (event.key === '/' && !isTyping) {
          event.preventDefault();
          window.location.href = '/search/';
        }
      });
    </script>
  </body>
</html>
