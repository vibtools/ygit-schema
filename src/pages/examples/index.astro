---
import Button from '@/components/buttons/Button';
import Card from '@/components/cards/Card';
import Container from '@/components/common/Container';
import CodeBlock from '@/components/documentation/CodeBlock';
import PageHeader from '@/components/documentation/PageHeader';
import Breadcrumb from '@/components/navigation/Breadcrumb';
import MainLayout from '@/layouts/MainLayout.astro';
import { readFile } from 'node:fs/promises';

const v1Example = await readFile(
  new URL('../../../examples/vibproject-full-example.ygit', import.meta.url),
  'utf-8',
);

const v2Example = await readFile(
  new URL('../../../examples/v2/vibproject-full-example.ygit', import.meta.url),
  'utf-8',
);

const dpmsFullExample = await readFile(
  new URL('../../../examples/v1/dpms/docs.full.manifest.ygit', import.meta.url),
  'utf-8',
);

const vibtoolsExample = await readFile(
  new URL('../../../examples/v1/vibtools/vibtools.json', import.meta.url),
  'utf-8',
);

const vibtoolsExamples = [
  {
    title: 'Product Catalog Manifest with Social OG & User Guides',
    description:
      'Complete vibtools.json manifest featuring assets (logo, banner, 1200x630 social OG card), non-technical document paths (quick-start, features, FAQ, what\'s new), download & demo links, and catalog flags.',
    path: '/examples/v1/vibtools/vibtools.json',
  },
] as const;

const dpmsExamples = [
  {
    title: 'Minimal manifest',
    description: 'The smallest valid DPMS Version 1 documentation manifest.',
    path: '/examples/v1/dpms/docs.manifest.ygit',
  },
  {
    title: 'Full manifest',
    description: 'Every supported DPMS Version 1 section, discovery rules, versions, and vendor extensions.',
    path: '/examples/v1/dpms/docs.full.manifest.ygit',
  },
] as const;

const v2Examples = [
  {
    title: 'Minimal manifest',
    description: 'The smallest valid VPMS Version 2 manifest.',
    path: '/examples/v2/vibproject-minimal-example.ygit',
  },
  {
    title: 'Full manifest',
    description: 'Every supported VPMS Version 2 root section and property.',
    path: '/examples/v2/vibproject-full-example.ygit',
  },
  {
    title: 'Desktop application',
    description: 'A cross-platform desktop application manifest.',
    path: '/examples/v2/vibproject-desktop-app-example.ygit',
  },
  {
    title: 'Web service',
    description: 'A containerized API and web-service manifest.',
    path: '/examples/v2/vibproject-web-service-example.ygit',
  },
  {
    title: 'Software library',
    description: 'A reusable package and library manifest.',
    path: '/examples/v2/vibproject-library-example.ygit',
  },
  {
    title: 'Community project',
    description: 'A community-owned open-source project manifest.',
    path: '/examples/v2/vibproject-community-project-example.ygit',
  },
  {
    title: 'Edge worker',
    description: 'A TypeScript edge-worker application manifest.',
    path: '/examples/v2/vibproject-worker-example.ygit',
  },
] as const;
---

<MainLayout
  category="example"
  title="Examples"
  description="Official valid VPMS and DPMS reference manifests."
>
  <Container class="py-5">
    <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Examples' }]} />

    <PageHeader
      title="Examples"
      description="Production-oriented manifests synchronized with official versioned schemas."
    />

    <section class="mb-8" aria-labelledby="dpms-examples">
      <div class="mb-4">
        <h2 id="dpms-examples" class="text-lg font-semibold text-text">DPMS Version 1</h2>

        <p class="mt-2 text-base text-content">
          Reference manifests for the Documentation Package Manifest Specification (<code>docs.manifest.ygit</code>).
        </p>
      </div>

      <div class="mb-5 grid gap-4 sm:grid-cols-2">
        {
          dpmsExamples.map((example) => (
            <Card as="article" hover class="flex h-full flex-col">
              <h3 class="text-h3 font-semibold text-text">{example.title}</h3>

              <p class="mt-2 mb-4 flex-1 text-base text-content">{example.description}</p>

              <div>
                <Button href={example.path} variant="secondary" download>
                  Download
                </Button>
              </div>
            </Card>
          ))
        }
      </div>

      <CodeBlock
        code={dpmsFullExample}
        language="json"
        title="docs.full.manifest.ygit — DPMS Version 1"
      />
    </section>

    <section class="mb-8" aria-labelledby="vibtools-examples">
      <div class="mb-4">
        <h2 id="vibtools-examples" class="text-lg font-semibold text-text">VibTools Catalog Manifest</h2>

        <p class="mt-2 text-base text-content">
          Official manifest format (<code>vibtools.json</code>) placed at project root for automated
          catalog discovery, 1-click GitHub import, social OG preview cards (1200×630), and
          non-technical user guides.
        </p>
      </div>

      <div class="mb-5 grid gap-4">
        {
          vibtoolsExamples.map((example) => (
            <Card as="article" hover class="flex h-full flex-col">
              <h3 class="text-h3 font-semibold text-text">{example.title}</h3>

              <p class="mt-2 mb-4 flex-1 text-base text-content">{example.description}</p>

              <div>
                <Button href={example.path} variant="secondary" download>
                  Download
                </Button>
              </div>
            </Card>
          ))
        }
      </div>

      <CodeBlock
        code={vibtoolsExample}
        language="json"
        title="vibtools.json — Product Catalog Manifest"
      />
    </section>

    <section class="mb-8" aria-labelledby="version-2-examples">
      <div class="mb-4">
        <h2 id="version-2-examples" class="text-lg font-semibold text-text">VPMS Version 2</h2>

        <p class="mt-2 text-base text-content">
          Frozen Version 2 reference manifests for common project types.
        </p>
      </div>

      <div class="mb-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          v2Examples.map((example) => (
            <Card as="article" hover class="flex h-full flex-col">
              <h3 class="text-h3 font-semibold text-text">{example.title}</h3>

              <p class="mt-2 mb-4 flex-1 text-base text-content">{example.description}</p>

              <div>
                <Button href={example.path} variant="secondary" download>
                  Download
                </Button>
              </div>
            </Card>
          ))
        }
      </div>

      <CodeBlock
        code={v2Example}
        language="json"
        title="vibproject-full-example.ygit — VPMS Version 2"
      />
    </section>

    <section aria-labelledby="version-1-example">
      <div class="mb-4">
        <h2 id="version-1-example" class="text-lg font-semibold text-text">VPMS Version 1</h2>

        <p class="mt-2 text-base text-content">Original stable Version 1 reference manifest.</p>
      </div>

      <Card class="mb-5">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div>
            <h3 class="text-h3 font-semibold text-text">Full Version 1 manifest</h3>

            <p class="mt-1 text-base text-content">
              Demonstrates every Version 1 root object and recommended property ordering.
            </p>
          </div>

          <Button href="/examples/vibproject-full-example.ygit" download> Download </Button>
        </div>
      </Card>

      <CodeBlock
        code={v1Example}
        language="json"
        title="vibproject-full-example.ygit — VPMS Version 1"
      />
    </section>
  </Container>
</MainLayout>
