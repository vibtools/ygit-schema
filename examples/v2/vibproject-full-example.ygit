  },
  "build": {
    "buildSystem": "Python and Node.js",
    "packageFormat": [
      "wheel",
      "sdist",
      "zip",
      "docker"
    ],
    "commands": {
      "install": "python -m pip install -r requirements.txt",
      "build": "python -m build",
      "test": "python -m pytest",
      "lint": "ruff check .",
      "format": "ruff format ."
    }
  },
  "release": {
    "strategy": "GitHub Releases",
    "versioning": "Semantic Versioning",
    "latestVersion": "2.4.1",
    "releaseNotes": "docs/release-notes/"
