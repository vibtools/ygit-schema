{
  "$schema": "https://schema.ygit.dev/vpms/v2/vibproject.schema.json",
  "schemaVersion": 2,
  "manifestVersion": "2.0.0",
  "project": {
    "id": "vib-schema-utils",
    "name": "Vib Schema Utilities",
    "description": "Reusable library for JSON Schema loading and validation.",
    "version": "0.9.0",
    "status": "beta",
    "visibility": "public"
  },
  "classification": {
    "ownerType": "organization",
    "productType": "library",
    "applicationType": "library",
    "distribution": "open-source",
    "lifecycle": "beta"
  },
  "license": {
    "name": "MIT License",
    "spdx": "MIT",
    "file": "LICENSE"
  },
  "technology": {
    "languages": [
      "Python"
    ],
    "libraries": [
      "jsonschema"
    ],
    "packageManagers": [
      "pip"
    ]
  },
  "entrypoints": {
    "application": "src/vib_schema_utils/__init__.py",
    "tests": "tests/",
    "documentation": "docs/README.md"
  },
  "distribution": {
    "githubReleases": "https://github.com/vibtools/vib-schema-utils/releases",
    "pypi": "https://pypi.org/project/vib-schema-utils/"
  },
  "quality": {
    "formatter": "Ruff",
    "linter": "Ruff",
    "testFramework": "Pytest",
    "coverage": "Coverage.py",
    "security": [
      "Dependabot",
      "pip-audit"
    ]
  },
  "metadata": {
    "specification": "VPMS",
    "specificationVersion": "2.0.0"
  }
}
